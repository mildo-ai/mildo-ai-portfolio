---
import type { Locale } from '../i18n/translations';
import { t } from '../i18n/translations';

interface Props {
  lang?: Locale;
}

const { lang = 'ko' } = Astro.props;
const tr = t(lang);
---

<section id="team" class="py-24 md:py-32">
  <div class="max-w-6xl mx-auto px-6">
    <div class="fade-up mb-16">
      <p class="font-mono text-sm text-[var(--color-accent)] mb-3">{tr.team.label}</p>
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight">{tr.team.title}</h2>
      <p class="text-[var(--color-text-secondary)] mt-4 max-w-2xl">{tr.team.sub}</p>
    </div>

    <div class="grid lg:grid-cols-3 gap-12">
      <!-- Career timeline -->
      <div class="lg:col-span-2 space-y-8">
        {tr.team.jobs.map((job) => (
          <div class="fade-up relative pl-8 border-l border-[var(--color-line)]">
            <div class="absolute left-[-5px] top-1.5 w-2.5 h-2.5 rounded-full bg-[var(--color-accent)] border-2 border-[var(--color-bg)]"></div>
            <p class="font-mono text-xs text-[var(--color-muted)] mb-1">{job.period}</p>
            <h3 class="text-lg font-semibold">
              {job.org} <span class="text-[var(--color-text-secondary)] font-normal">/ {job.role}</span>
            </h3>
            <p class="text-sm text-[var(--color-text-secondary)] mt-2 leading-relaxed">{job.description}</p>
            <div class="flex flex-wrap gap-2 mt-3">
              {job.tags.map((tag) => (
                <span class="text-xs font-mono px-2 py-0.5 rounded bg-[var(--color-surface-2)] text-[var(--color-muted)]">{tag}</span>
              ))}
            </div>
          </div>
        ))}
      </div>

      <!-- Education & Credentials -->
      <div class="space-y-10">
        <div class="fade-up">
          <h3 class="font-mono text-sm text-[var(--color-accent)] mb-4">{tr.team.eduTitle}</h3>
          <div class="space-y-4">
            {tr.team.education.map((edu) => (
              <div class="p-4 rounded-lg bg-[var(--color-surface)] border border-[var(--color-line)]">
                <p class="text-sm font-semibold">{edu.school}</p>
                <p class="text-xs text-[var(--color-muted)] mt-1">{edu.degree}</p>
              </div>
            ))}
          </div>
        </div>

        <div class="fade-up">
          <h3 class="font-mono text-sm text-[var(--color-accent)] mb-4">{tr.team.certTitle}</h3>
          <div class="flex flex-wrap gap-2">
            {tr.team.certifications.map((cert) => (
              <span class="text-xs font-mono px-3 py-1.5 rounded-lg bg-[var(--color-surface)] text-[var(--color-text-secondary)] border border-[var(--color-line)]">
                {cert}
              </span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
