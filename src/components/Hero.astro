---
import type { Locale } from '../i18n/translations';
import { t } from '../i18n/translations';

interface Props {
  lang?: Locale;
}

const { lang = 'ko' } = Astro.props;
const tr = t(lang);

// Live product proof links — every one is in production
const proofLinks = [
  { label: 'cropcast.ai', href: 'https://cropcast.ai' },
  { label: 'provenio.art', href: 'https://provenio.art' },
  { label: 'subswap.app', href: 'https://subswap.app' },
  { label: lang === 'ko' ? '묘운 (iOS)' : 'Myoun (iOS)', href: 'https://myoun.kr' },
];
---

<section id="hero" class="relative min-h-screen flex items-center pt-24">
  <!-- Glow orb background -->
  <div class="absolute top-1/3 left-1/2 -translate-x-1/2 w-[700px] h-[700px] bg-[var(--color-accent)]/5 rounded-full blur-[120px] pointer-events-none"></div>
  <!-- Grid -->
  <div class="absolute inset-0 opacity-[0.025]" style="background-image: linear-gradient(rgba(255,255,255,0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.1) 1px, transparent 1px); background-size: 60px 60px;"></div>

  <div class="relative max-w-6xl mx-auto px-6 py-20 md:py-32 w-full z-10">
    <div class="fade-up">
      <!-- Terminal badge -->
      <div class="inline-flex items-center gap-3 bg-[var(--color-surface)] px-4 py-2 rounded-lg mb-8 border border-[var(--color-line)]">
        <span class="font-mono text-sm text-[var(--color-accent-green)]">~ $</span>
        <span class="font-mono text-sm text-[var(--color-text-secondary)]">{tr.hero.badge}<span class="cursor-blink"></span></span>
      </div>

      <h1 class="text-4xl md:text-6xl font-bold tracking-tight leading-[1.15] mb-8">
        <span class="text-[var(--color-text)]">{tr.hero.taglineTop}</span><br />
        <span class="text-[var(--color-accent)]">{tr.hero.taglineAccent}</span>
      </h1>

      <p class="text-lg md:text-xl text-[var(--color-text-secondary)] max-w-2xl leading-relaxed mb-12">
        {tr.hero.sub}<br class="hidden md:block" />
        <span class="text-[var(--color-text)]">{tr.hero.highlight}</span>
      </p>

      <!-- CTAs -->
      <div class="flex flex-col sm:flex-row gap-4 mb-12">
        <a
          href="#contact"
          class="inline-flex items-center justify-center px-8 py-3.5 bg-[var(--color-accent)] text-[var(--color-bg)] font-semibold rounded-lg hover:opacity-90 transition-opacity text-sm tracking-wide"
        >
          {tr.hero.cta1}
        </a>
        <a
          href="#services"
          class="inline-flex items-center justify-center px-8 py-3.5 border border-[var(--color-line-accent)] text-[var(--color-accent)] rounded-lg hover:bg-[var(--color-accent-dim)] transition-colors text-sm tracking-wide"
        >
          {tr.hero.cta2}
        </a>
      </div>

      <!-- Live product proof links -->
      <div class="flex items-center gap-x-6 gap-y-2 flex-wrap">
        <span class="text-xs text-[var(--color-muted)] uppercase tracking-wider">{tr.hero.proofLabel}</span>
        {proofLinks.map((link) => (
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            class="text-[var(--color-muted)] hover:text-[var(--color-accent)] transition-colors text-sm font-mono flex items-center gap-1.5"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-accent-green)] inline-block"></span> {link.label}
          </a>
        ))}
      </div>
    </div>

    <!-- Stats bar -->
    <div class="mt-20 pt-10 border-t border-[var(--color-line)] grid grid-cols-2 md:grid-cols-4 gap-8 fade-up">
      {tr.hero.stats.map((stat) => (
        <div>
          <div class="font-mono text-3xl font-bold text-[var(--color-accent)]">{stat.value}</div>
          <div class="text-xs text-[var(--color-muted)] mt-1 uppercase tracking-wider">{stat.label}</div>
        </div>
      ))}
    </div>
  </div>
</section>
