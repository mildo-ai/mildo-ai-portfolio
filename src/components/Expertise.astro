---
import type { Locale } from '../i18n/translations';
import { t } from '../i18n/translations';

interface Props {
  lang?: Locale;
}

const { lang = 'ko' } = Astro.props;
const tr = t(lang);

// Icons for the 4 expertise domains (order matches tr.expertise.items)
const icons = ['{}', '(G)', '<->', '>_'];
---

<section id="expertise" class="py-24 md:py-32 bg-[var(--color-surface)]">
  <div class="max-w-6xl mx-auto px-6">
    <div class="fade-up mb-16">
      <p class="font-mono text-sm text-[var(--color-accent)] mb-3">{tr.expertise.label}</p>
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight">{tr.expertise.title}</h2>
      <p class="text-[var(--color-text-secondary)] mt-4 max-w-2xl">{tr.expertise.sub}</p>
    </div>

    <div class="grid md:grid-cols-2 gap-6">
      {tr.expertise.items.map((item, i) => (
        <div class="fade-up rounded-xl border border-[var(--color-line)] bg-[var(--color-bg)] p-8 hover:border-[var(--color-line-accent)] transition-colors">
          <div class="flex items-center gap-3 mb-4">
            <span class="font-mono text-sm text-[var(--color-accent)] bg-[var(--color-accent-dim)] px-2.5 py-1.5 rounded">{icons[i]}</span>
            <h3 class="font-semibold text-lg md:text-xl">{item.name}</h3>
          </div>
          <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed mb-6">{item.description}</p>
          <div class="flex flex-wrap gap-2">
            {item.tags.map((tag) => (
              <span class="text-xs font-mono px-3 py-1.5 rounded-lg bg-[var(--color-surface-2)] text-[var(--color-text-secondary)] border border-[var(--color-line)]">
                {tag}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
