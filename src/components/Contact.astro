---
import type { Locale } from '../i18n/translations';
import { t } from '../i18n/translations';

interface Props {
  lang?: Locale;
}

const { lang = 'ko' } = Astro.props;
const tr = t(lang);

const email = 'ceo@mildo.ai';
const mailSubject = lang === 'ko' ? '프로젝트 문의' : 'Project Inquiry';
---

<section id="contact" class="py-24 md:py-32 bg-[var(--color-surface)]">
  <div class="max-w-6xl mx-auto px-6">
    <div class="max-w-2xl mx-auto text-center fade-up">
      <p class="font-mono text-sm text-[var(--color-accent)] mb-3">{tr.contact.label}</p>
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-6">
        {tr.contact.title}
      </h2>
      <p class="text-[var(--color-text-secondary)] text-lg leading-relaxed mb-10">
        {tr.contact.sub}
      </p>

      <div class="flex flex-col items-center justify-center gap-5 mb-8">
        <a
          href={`mailto:${email}?subject=${encodeURIComponent(mailSubject)}`}
          class="inline-flex items-center justify-center px-8 py-4 bg-[var(--color-accent)] text-[var(--color-bg)] font-semibold rounded-lg hover:opacity-90 transition-opacity text-lg w-full sm:w-auto"
        >
          {tr.contact.emailBtn}
        </a>
        <div class="font-mono text-base text-[var(--color-text-secondary)]">
          <a href={`mailto:${email}`} class="hover:text-[var(--color-accent)] transition-colors">
            {email}
          </a>
        </div>
      </div>

      <p class="font-mono text-xs text-[var(--color-muted)]">{tr.contact.note}</p>
    </div>
  </div>
</section>

<!-- Footer -->
<footer class="border-t border-[var(--color-line)] py-8">
  <div class="max-w-6xl mx-auto px-6 flex flex-col md:flex-row items-center justify-between gap-4">
    <p class="font-mono text-sm text-[var(--color-muted)]">
      &gt;_ mildo.ai — {tr.contact.footerTag}
    </p>
    <div class="flex items-center gap-6 flex-wrap justify-center">
      <a href="https://cropcast.ai" target="_blank" rel="noopener noreferrer" class="text-sm text-[var(--color-muted)] hover:text-[var(--color-accent)] transition-colors">cropcast.ai</a>
      <a href="https://provenio.art" target="_blank" rel="noopener noreferrer" class="text-sm text-[var(--color-muted)] hover:text-[var(--color-accent)] transition-colors">provenio.art</a>
      <a href="https://subswap.app" target="_blank" rel="noopener noreferrer" class="text-sm text-[var(--color-muted)] hover:text-[var(--color-accent)] transition-colors">subswap.app</a>
      <a href="https://myoun.kr" target="_blank" rel="noopener noreferrer" class="text-sm text-[var(--color-muted)] hover:text-[var(--color-accent)] transition-colors">{lang === 'ko' ? '묘운' : 'Myoun'}</a>
    </div>
    <p class="text-xs text-[var(--color-muted)]">&copy; 2026 MILDO. All rights reserved.</p>
  </div>
</footer>
